# 复制为 .env 后按需修改（.env 不会被提交）
# 时区：服务端“今天/现在”都按这个时区计算
APP_TIMEZONE=Asia/Shanghai

# 数据库（MariaDB / MySQL 均可；本机 MariaDB 示例为 3308）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=qingheju

# 鉴权（必填）：JWT 签名密钥，至少 32 位随机字符串
# 生成：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=please-change-me

# 跨域（可选）：逗号分隔的允许来源；留空表示只允许同源
CORS_ORIGINS=

# 登录/注册限流（可选，单位：次）
REGISTER_RATE_LIMIT_MAX=10
LOGIN_IP_RATE_LIMIT_MAX=30
LOGIN_USER_RATE_LIMIT_MAX=10

# 发帖/评论/点赞限流（可选，单位：次）
POST_RATE_LIMIT_MAX=10
COMMENT_RATE_LIMIT_MAX=30
LIKE_RATE_LIMIT_MAX=120

# JSON 请求体上限（可选）：普通接口默认 2mb；
# 发帖接口单独放宽，默认 12mb（原图 base64 ≤10MB + 缩略图 ≤1MB）
JSON_BODY_LIMIT=2mb
POST_BODY_LIMIT=12mb

# AI 配置（四个必填项；真实值只写在 server/.env，不会提交）
AI_BASE_URL=https://your-gateway.example/v1
AI_FORMAT=responses          # responses | chat | messages
AI_API_KEY=your-api-key
AI_MODEL=your-model

# 可选
AI_MAX_TOKENS=1000
AI_TEMPERATURE=0.8          # 数字；填 default / omit / none 表示不传，用模型默认温度
AI_STREAM=true              # 默认流式输出；false 则返回普通 JSON

# 上下文限制（一般不需要改）
# 一次请求最多携带的历史消息条数
AI_MAX_MESSAGES=15
# 输入上下文 token 上限（含 system prompt；超出时从最早的消息开始丢弃）
AI_CONTEXT_TOKENS=80000
# 单条消息字符上限（超出截断）
AI_MAX_MESSAGE_CHARS=20000
# AI 限流：时间窗口（毫秒）与窗口内最大请求数
AI_RATE_LIMIT_WINDOW_MS=600000
AI_RATE_LIMIT_MAX=30

# 本地启动端口（start.ps1 会覆盖它）
PORT=3112
